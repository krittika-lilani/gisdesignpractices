---
import PageLayout from "@layouts/PageLayout.astro";
import { FullPageMap, loadMapConfig } from "@maplibre-yaml/astro";

const map = await loadMapConfig("./src/maps/india.yaml");
---

<PageLayout title="Water hyacinth" description="Where water hyacinth has been recorded, 1837 to 2026" bleed>
  <FullPageMap
    id="india"
    config={map}
    style="top: var(--header-h); height: calc(100vh - var(--header-h));"
  >
    <div slot="top-left" class="rounded bg-white/90 px-3 py-2 text-sm text-stone-700 shadow max-w-72">
      <strong>Water hyacinth, first recorded by</strong>
      <div class="flex items-center gap-2 mt-1">
        <span id="year-label" class="text-lg font-semibold w-12">2026</span>
        <input id="year" type="range" min="1837" max="2026" value="2026" class="flex-1" aria-label="year" />
        <button id="play" class="rounded border px-2">play</button>
      </div>
      <div class="flex items-center gap-2 mt-2 text-xs">
        <span>fewer records</span>
        <span class="h-2 flex-1 rounded-sm border border-stone-300" style="background: linear-gradient(90deg, #7a62b8, #a98fe0, #d6c6f5, #fbf6ff);"></span>
        <span>more records</span>
      </div>
      <p class="mt-1 text-xs">Click a cell for details</p>
    </div>
  </FullPageMap>
</PageLayout>

<script>
  const mapEl = document.getElementById("india") as any;
  const slider = document.getElementById("year") as HTMLInputElement;
  const label = document.getElementById("year-label") as HTMLElement;
  const play = document.getElementById("play") as HTMLButtonElement;
  let timer: ReturnType<typeof setInterval> | undefined;

  // show only cells first recorded in or before the slider's year
  function setYear() {
    label.textContent = slider.value;
    const map = mapEl?.getMap?.();
    if (map?.getLayer("hyacinth")) map.setFilter("hyacinth", ["<=", ["get", "first"], Number(slider.value)]);
  }

  function stop() {
    clearInterval(timer);
    timer = undefined;
    play.textContent = "play";
  }

  slider.addEventListener("input", () => { stop(); setYear(); });
  // hide the basemap's labels and state borders (country borders stay)
  function quietBasemap() {
    const map = mapEl?.getMap?.();
    for (const layer of map?.getStyle()?.layers ?? []) {
      const isLabel = layer.type === "symbol";
      const isState = layer["source-layer"] === "boundary" && !layer.id.includes("country");
      if (layer.id !== "hyacinth" && (isLabel || isState)) map.setLayoutProperty(layer.id, "visibility", "none");
    }
  }

  mapEl?.addEventListener("ml-map:load", () => { quietBasemap(); setYear(); });

  play.addEventListener("click", () => {
    if (timer) return stop();
    if (Number(slider.value) >= 2026) slider.value = "1837";
    play.textContent = "pause";
    timer = setInterval(() => {
      if (Number(slider.value) >= 2026) return stop();
      slider.value = String(Number(slider.value) + 1);
      setYear();
    }, 80);
  });
</script>
